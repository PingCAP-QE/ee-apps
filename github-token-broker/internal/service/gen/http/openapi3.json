{"openapi":"3.0.3","info":{"title":"GitHub Token Broker","description":"Mints least-privilege GitHub App installation tokens for CI workloads.","version":"0.1.0"},"servers":[{"url":"http://localhost:8080"}],"paths":{"/healthz":{"get":{"tags":["token"],"summary":"healthz token","description":"Liveness check.","operationId":"token#healthz","responses":{"200":{"description":"OK response.","content":{"application/json":{"schema":{"type":"string","example":"Sed sint animi praesentium sit excepturi."},"example":"Quis officiis ut."}}}}}},"/readyz":{"get":{"tags":["token"],"summary":"readyz token","description":"Readiness check.","operationId":"token#readyz","responses":{"200":{"description":"OK response.","content":{"application/json":{"schema":{"type":"string","example":"Provident illo delectus exercitationem fugit in."},"example":"Veniam officia et quae aut."}}},"503":{"description":"not_ready: The service is not ready to serve requests.","content":{"application/vnd.goa.error":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/token":{"post":{"tags":["token"],"summary":"issue token","description":"Issue a GitHub App installation token.","operationId":"token#issue","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/TokenPayload"},"example":{"permissions":{"Iusto et debitis itaque laborum.":"Similique voluptatem deleniti enim qui."},"repo":"example-org/example-repo","repositories":["Aspernatur omnis.","Vel hic nisi cupiditate et provident molestias."]}}}},"responses":{"200":{"description":"OK response.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TokenResult"},"example":{"expires_at":"2007-04-15T21:24:04Z","installation_id":7625086961475705147,"source":"app","token":"Fuga id."}}}},"400":{"description":"bad_request: Invalid request.","content":{"application/vnd.goa.error":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"unauthorized: Caller is not authenticated.","con