issions subset.","example":{"Aut et est qui voluptatem amet expedita.":"Ipsa molestiae inventore provident aut veniam architecto.","Dolore eaque veniam sed.":"Amet voluptatibus quo commodi eos.","Itaque quia.":"Quasi ipsa qui aliquam fugiat."},"additionalProperties":{"type":"string","example":"Dolores maiores reprehenderit dolore perferendis et quia."}},"repo":{"type":"string","description":"Target repository in owner/name form.","example":"example-org/example-repo","pattern":"^[^/]+/[^/]+$"},"repositories":{"type":"array","items":{"type":"string","example":"Repudiandae nulla dolorem adipisci."},"description":"Optional repository names to narrow the token to.","example":["Aut non non ut eos omnis fugiat.","Placeat autem autem nostrum est eligendi.","Fugit officia vel et et.","Maxime sit voluptas."]}},"description":"Token request.","example":{"permissions":{"Eos dolorem ea omnis rem saepe temporibus.":"Labore veritatis illo optio quisquam sed sint.","Et non ex nemo dolorem qui.":"Libero non eveniet quae.","Sequi necessitatibus architecto omnis et architecto quo.":"Quam maxime neque tempora repudiandae."},"repo":"example-org/example-repo","repositories":["Nisi excepturi.","Suscipit voluptate pariatur.","Nobis soluta voluptatem ut rerum saepe."]},"required":["repo"]},"TokenResult":{"type":"object","properties":{"expires_at":{"type":"string","description":"Token expiry (RFC3339).","example":"2015-07-10T06:25:14Z","format":"date-time"},"installation_id":{"type":"integer","description":"GitHub App installation ID.","example":1124949687485937000,"format":"int64"},"source":{"type":"string","description":"Token source.","example":"pat","enum":["app","pat"]},"token":{"type":"string","description":"Installation access token.","example":"Autem velit."}},"example":{"expires_at":"2009-08-10T20:13:52Z","installation_id":2603343161838669580,"source":"pat","token":"Quos harum ducimus rerum."},"required":["token","source"]}}},"tags":[{"name":"token","description":"Issues GitHub App i