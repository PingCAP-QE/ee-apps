# Example configuration file for chatops-lark

# Bot configuration
app_id: <app_id> # or set it from cli options `--app-id`
app_secret: <app_secret> # or set it from cli options `--app-secret`

# GitHub App token broker client, shared by every command that calls the GitHub
# API (/repo-admins, /cloud-image). Remove this block to disable the broker;
# commands then only work with a static `github_token`.
github:
  # Optional. When the block is present and this is empty, the in-cluster
  # service DNS name is used. GITHUB_TOKEN_BROKER_URL overrides this value.
  broker_url: "http://github-token-broker.github-token-broker.svc"
  # Projected ServiceAccount token used to authenticate to the broker.
  # GITHUB_TOKEN_BROKER_TOKEN_FILE overrides this value.
  broker_token_file: "/var/run/secrets/kubernetes.io/serviceaccount/token"
  # Optional static token. It is used only when the broker denies the request,
  # and every fallback is logged as a warning. Leave empty in production.
  token: ""

# Cherry pick configuration
cherry_pick_invite:
  audit:
    webhook: "https://open.feishu.cn/open-apis/bot/v2/hook/xxx"
  # Optional broker fallback. The broker scopes administration: write to the
  # ti-chi-bot fork repositories.
  github_token: "ghp_xxx"

# Ask command configuration
ask:
  audit:
    webhook: "https://open.feishu.cn/open-apis/bot/v2/hook/xxx"
  llm:
    azure_config:
      api_key: "your-api-key"
      base_url: "https://your-deployment.openai.azure.com"
      api_version: "2023-05-15"
    model: "gpt-4"
    system_prompt: |
      You are a helpful assistant for PingCAP employees.
      You have access to various tools that can help answer questions about our infrastructure and services.
      Always respond with accurate and helpful information.
    mcp_servers:
      tidb_server:
        base_url: "https://mcp-server.example.com"
      monitoring_server:
        base_url: "https://monitoring-mcp.example.com"

# DevBuild configuration
devbuild:
  audit:
    webhook: "https://open.feishu.cn/open-apis/bot/v2/hook/xxx"
  api_url: "https://tibuild.pingcap.net/api/v2/devbuilds"

# Cloud image query configuration
registry_image:
  audit:
    webhook: "https://open.feishu.cn/open-apis/bot/v2/hook/xxx"
  owner: "tidbcloud" # Optional, defaults to tidbcloud
  repo: "docker-image-controller" # Optional, defaults to docker-image-controller
  workflow: "query-image-tag.yml" # Optional, defaults to query-image-tag.yml
  ref: "main" # Optional, defaults to the repository default branch when omitted
  # Optional broker fallback; prefer the top-level `github` block.
  github_token: "ghp_xxx"
hotfix:
  api_url: "https://tibuild.pingcap.net/api/v2/hotfix" # API endpoint for hotfix operations
  audit:
    webhook: "https://open.feishu.cn/open-apis/bot/v2/hook/xxx" # Webhook URL for audit logs
    title: "Custom audit title" # Optional title for audit messages
    result: true # Include command results in audit logs

# RepoAdmins command configuration
repo_admins:
  audit:
    webhook: "https://open.feishu.cn/open-apis/bot/v2/hook/xxx"
  # Optional broker fallback; prefer the top-level `github` block.
  github_token: "ghp_xxx"

# Debug mode
debug: false
