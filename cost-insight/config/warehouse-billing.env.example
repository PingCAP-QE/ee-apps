# Staged billing-read profile. Do not enable recurring writers before canary approval.
# Defaults to direct Workload Identity; never use a service-account key.
# Approved target-SA table access expires 2027-04-25T06:52:47Z.
export COST_INSIGHT_BILLING_BQ_PROJECT=warehouse-f80fbbe8e8
export COST_INSIGHT_BILLING_BQ_LOCATION=us-west1
unset COST_INSIGHT_BILLING_BQ_IMPERSONATE_SERVICE_ACCOUNT

# Local ADC only: explicitly opt in AFTER sourcing this profile. The caller
# needs roles/iam.serviceAccountTokenCreator on the target SA. The billing
# query project above is required; it is never inferred from the caller's ADC.
# export COST_INSIGHT_BILLING_BQ_IMPERSONATE_SERVICE_ACCOUNT=hxprog-e5d756e67e8641f386ab0e9@warehouse-f80fbbe8e8.iam.gserviceaccount.com
# Pods already bound directly to that GSA must leave impersonation unset.
# The existing ci-dashboard GSA cannot mint the target SA's token (runtime 403).
export COST_INSIGHT_GCP_BILLING_TABLE=warehouse-f80fbbe8e8.raw_gcp_billing.gcp_billing_export_resource_v1_01D088_8F9CF2_8AF1C6

# AWS/Azure/Alibaba marts are read-only comparison sources, NOT replacements for
# current detail importers. They do not expose the full attribution/resource grain.
