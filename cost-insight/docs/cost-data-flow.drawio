<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="30.3.14">
  <diagram name="Cost Data Flow">
    <mxGraphModel dx="2400" dy="1700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="&lt;b&gt;Cost 数据流：云账单 → 日汇总 → 归因 → Dashboard&lt;/b&gt;&#xa;当前实现（cost-insight + ci-dashboard）；虚线为控制/辅助关联" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontColor=#1f2937;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="20" width="1660" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="lane_sources" value="① 外部数据源" style="swimlane;startSize=40;horizontal=0;collapsible=0;rounded=1;html=1;fontStyle=1;fontSize=15;fillColor=#f5f5f5;strokeColor=#666666;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="20" y="90" width="340" height="1560" as="geometry"/>
        </mxCell>
        <mxCell id="lane_extract" value="② 选数 / 预聚合 / 分摊" style="swimlane;startSize=40;horizontal=0;collapsible=0;rounded=1;html=1;fontStyle=1;fontSize=15;fillColor=#dae8fc;strokeColor=#6c8ebf;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="380" y="90" width="530" height="1560" as="geometry"/>
        </mxCell>
        <mxCell id="lane_ledger" value="③ TiDB 事实表 / 台账" style="swimlane;startSize=40;horizontal=0;collapsible=0;rounded=1;html=1;fontStyle=1;fontSize=15;fillColor=#d5e8d4;strokeColor=#82b366;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="930" y="90" width="440" height="1560" as="geometry"/>
        </mxCell>
        <mxCell id="lane_semantic" value="④ 语义计算 / 归因" style="swimlane;startSize=40;horizontal=0;collapsible=0;rounded=1;html=1;fontStyle=1;fontSize=15;fillColor=#e1d5e7;strokeColor=#9673a6;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="1390" y="90" width="500" height="1560" as="geometry"/>
        </mxCell>
        <mxCell id="lane_serve" value="⑤ 汇总结果 / 消费" style="swimlane;startSize=40;horizontal=0;collapsible=0;rounded=1;html=1;fontStyle=1;fontSize=15;fillColor=#ffe6cc;strokeColor=#d79b00;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="1910" y="90" width="450" height="1560" as="geometry"/>
        </mxCell>

        <mxCell id="gcp_bq" value="&lt;b&gt;GCP BigQuery&lt;/b&gt;&#xa;Cloud Billing Detailed Export&#xa;约 33 万原始行/天&#xa;权威明细与发票追溯源" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="lane_sources">
          <mxGeometry x="30" y="80" width="270" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="aws_bq" value="&lt;b&gt;AWS CUR / Split Cost in BigQuery&lt;/b&gt;&#xa;Legacy CUR + EKS split-cost&#xa;按 billing_month 分区" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="lane_sources">
          <mxGeometry x="30" y="250" width="270" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="roster_source" value="&lt;b&gt;Roster + TCMS&lt;/b&gt;&#xa;roster_employees / roster_groups&#xa;员工 GitHub、邮箱、组、经理&#xa;TCMS allocation 生效区间" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="lane_sources">
          <mxGeometry x="30" y="520" width="270" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="gke_metering" value="&lt;b&gt;GKE Metering BigQuery&lt;/b&gt;&#xa;gke_cluster_resource_usage&#xa;CPU seconds / memory byte-seconds&#xa;cluster + workload + CI labels" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="lane_sources">
          <mxGeometry x="30" y="830" width="270" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="cloud_api" value="&lt;b&gt;AWS / GCP Cloud APIs&lt;/b&gt;&#xa;未挂载 EBS / Persistent Disk&#xa;volume 状态、大小、标签" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="lane_sources">
          <mxGeometry x="30" y="1190" width="270" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="k8s_events" value="&lt;b&gt;Kubernetes Pod / PVC&lt;/b&gt;&#xa;Pod watcher / sync-pods&#xa;PV 名称 ↔ Pod 与 CI labels" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="lane_sources">
          <mxGeometry x="30" y="1350" width="270" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="billing_aggregate" value="&lt;b&gt;Billing Summary Import&lt;/b&gt;&#xa;&lt;font color=&quot;#374151&quot;&gt;选数&lt;/font&gt;：active vendor/account；有界 export partition；usage_date ≥ 起始日&#xa;&lt;font color=&quot;#374151&quot;&gt;标准化&lt;/font&gt;：vendor/account、service/SKU/usage type、region、CI labels、resource/workload、allocation scope&#xa;&lt;font color=&quot;#374151&quot;&gt;GCP GROUP BY&lt;/font&gt;：export partition + usage day + account/billing + service/SKU + region + author/org/repo/branch + resource&#xa;&lt;font color=&quot;#374151&quot;&gt;AWS GROUP BY&lt;/font&gt;：export month + usage day + account/billing + service/SKU + region + author/org/repo + tags；split source 额外保留 workload/scope&#xa;&lt;font color=&quot;#374151&quot;&gt;指标&lt;/font&gt;：SUM(list/effective/credit/net cost)，MAX(export_time)&#xa;生成稳定 source_row_hash，按分区幂等 upsert" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="lane_extract">
          <mxGeometry x="30" y="70" width="470" height="360" as="geometry"/>
        </mxCell>
        <mxCell id="resource_aggregate" value="&lt;b&gt;Weekly Resource Investigation Import&lt;/b&gt;&#xa;有界 export + usage window；只保留 resource_name 非空&#xa;高基数维度：resource、namespace、workload、vendor tags、author/org/repo/branch&#xa;按 export partition + usage day + resource 维度聚合&#xa;计算 usage_seconds（仅时间类单位）及四类 cost" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="lane_extract">
          <mxGeometry x="30" y="470" width="470" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="gcp_allocate" value="&lt;b&gt;GCP GKE Workload Allocation&lt;/b&gt;&#xa;账单侧只选可确认的 GKE Compute Engine CPU/Memory 与 control-plane list cost&#xa;Metering 侧按 day + cluster + workload + labels 汇总 CPU / memory usage&#xa;allocation_weight = workload usage / cluster total&#xa;allocated list_cost = node list_cost × weight" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="lane_extract">
          <mxGeometry x="30" y="760" width="470" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="aws_allocate" value="&lt;b&gt;AWS EKS Split / Parent Residual&lt;/b&gt;&#xa;从 split-cost BQ 识别 pod child、parent direct、parent residual&#xa;先按 day + parent + pod 计算 residual allocation_weight&#xa;再与 normalized summary 合并，发布 workload 级 list cost&#xa;保留 source_allocation_scope 与 allocation_version" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="lane_extract">
          <mxGeometry x="30" y="980" width="470" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="block_scan" value="&lt;b&gt;Unattached Block Scanner&lt;/b&gt;&#xa;枚举 AWS/GCP volume；筛选 available/unattached&#xa;归一 vendor/account/region/volume；保留首次发现时间与 owner tags" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="lane_extract">
          <mxGeometry x="30" y="1200" width="470" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="source_control" value="&lt;b&gt;采集控制&lt;/b&gt;&#xa;cost_sources：允许采集的 vendor/account、source table/schema&#xa;cost_job_state：每个 source/job 的 watermark、状态、错误" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="lane_extract">
          <mxGeometry x="30" y="1380" width="470" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="summary_table" value="&lt;b&gt;cost_bq_export_summary_daily&lt;/b&gt;&#xa;常规账单日汇总台账&#xa;&lt;b&gt;粒度&lt;/b&gt;：vendor/account + export partition + usage day + 标准账单/业务/资源维度&#xa;&lt;b&gt;指标&lt;/b&gt;：list/effective/credit/net cost&#xa;同一 source_row_hash 可被晚到修订覆盖" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="lane_ledger">
          <mxGeometry x="30" y="100" width="380" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="roster_tables" value="&lt;b&gt;roster_* + TCMS allocation&lt;/b&gt;&#xa;当前员工、组、经理与业务映射" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="lane_ledger">
          <mxGeometry x="30" y="350" width="380" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="unmatched_table" value="&lt;b&gt;cost_unmatched_resource_daily&lt;/b&gt;&#xa;资源调查日表（周窗口刷新）&#xa;&lt;b&gt;粒度&lt;/b&gt;：vendor/account + export partition + usage day + service/SKU + resource/workload/labels&#xa;故意保留高基数，不进入常规 summary" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="lane_ledger">
          <mxGeometry x="30" y="490" width="380" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="workload_table" value="&lt;b&gt;cost_kubernetes_workload_allocation_daily&lt;/b&gt;&#xa;&lt;b&gt;粒度&lt;/b&gt;：usage day + vendor/account + cluster + scope/component + namespace/workload + CI labels&#xa;&lt;b&gt;指标&lt;/b&gt;：weight、source node list cost、allocated list cost" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="lane_ledger">
          <mxGeometry x="30" y="790" width="380" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="residual_table" value="&lt;b&gt;cost_aws_parent_residual_allocation_daily&lt;/b&gt;&#xa;&lt;b&gt;粒度&lt;/b&gt;：usage day + parent resource + pod resource + allocation version&#xa;AWS EKS residual 分摊审计台账" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="lane_ledger">
          <mxGeometry x="30" y="1010" width="380" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="block_table" value="&lt;b&gt;cost_unattached_block_volume_daily&lt;/b&gt;&#xa;&lt;b&gt;粒度&lt;/b&gt;：snapshot day + vendor/account + region + volume&#xa;状态、GiB、owner、first seen" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="lane_ledger">
          <mxGeometry x="30" y="1210" width="380" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="pvc_table" value="&lt;b&gt;cost_kubernetes_pvc_pod_mapping&lt;/b&gt;&#xa;PV name ↔ pod UID + author/org/repo&#xa;供 GCP 存储账单归因" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="lane_ledger">
          <mxGeometry x="30" y="1380" width="380" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="attribution" value="&lt;b&gt;Summary Attribution Refresh&lt;/b&gt;&#xa;&lt;b&gt;输入&lt;/b&gt;：summary + roster/TCMS + PVC mapping&#xa;&lt;b&gt;身份解析&lt;/b&gt;：source owner / author override → GitHub ID → email / local-part → unmatched&#xa;&lt;b&gt;补充&lt;/b&gt;：employee_id、group_id、manager_id、attribution status/source；组经理作为 fallback&#xa;&lt;b&gt;再次汇总（去掉 export partition）&lt;/b&gt;：&#xa;usage day + vendor/account + service/SKU/driver/region + org/repo/branch/resource + allocation/workload + attribution identity&#xa;&lt;b&gt;指标&lt;/b&gt;：SUM 四类 cost，COUNT source rows&#xa;按 vendor/account/date 删除后重建，可吸收晚到修订和 roster 修复" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="lane_semantic">
          <mxGeometry x="30" y="90" width="440" height="350" as="geometry"/>
        </mxCell>
        <mxCell id="dashboard_aggregate" value="&lt;b&gt;Dashboard 查询时聚合&lt;/b&gt;&#xa;在 attribution / workload / unmatched 上按请求继续 GROUP BY：&#xa;日期（日/月/期间）、vendor/account、service/SKU/cost driver、region、org/repo/branch、author/owner、group/manager、namespace/workload、attribution status&#xa;指标：SUM(list/effective/credit/net cost)、allocated/unallocated、占比与趋势" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="lane_semantic">
          <mxGeometry x="30" y="500" width="440" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="allocation_compare" value="&lt;b&gt;Kubernetes 对账 / 未分配计算&lt;/b&gt;&#xa;attribution 作为账单总额&#xa;workload allocation 作为已分摊 workload list cost&#xa;按 source_summary_row_hash / 日期维度关联&#xa;展示 allocated、unallocated 与分摊覆盖率" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="lane_semantic">
          <mxGeometry x="30" y="790" width="440" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="budget_calc" value="&lt;b&gt;Budget vs Actual&lt;/b&gt;&#xa;cost_budgets 的期间预算 / label_filters&#xa;对 attribution actual 做同范围汇总&#xa;年度预算可派生为月度额度" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="lane_semantic">
          <mxGeometry x="30" y="1200" width="440" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="retirement_note" value="&lt;b&gt;已退役路径（015 手动迁移后）&lt;/b&gt;&#xa;cost_raw_details 不再作为 TiDB 中间层&#xa;invoice/raw 明细调查直接回 BigQuery" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="lane_semantic">
          <mxGeometry x="30" y="1380" width="440" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="attribution_table" value="&lt;b&gt;cost_attribution_daily&lt;/b&gt;&#xa;Dashboard 主事实汇总表&#xa;&lt;b&gt;粒度&lt;/b&gt;：usage day + 云/账单/业务/资源/workload + 归因身份&#xa;不再包含 export partition&#xa;保留 matched / unmatched / unattributed" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="lane_serve">
          <mxGeometry x="30" y="100" width="390" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="cost_api" value="&lt;b&gt;CI Dashboard Cost API / 页面&lt;/b&gt;&#xa;总成本与趋势&#xa;服务 / SKU / driver / region&#xa;repo / branch / author / group / manager&#xa;Kubernetes allocated vs unallocated&#xa;unmatched resource investigation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;" vertex="1" parent="lane_serve">
          <mxGeometry x="30" y="480" width="390" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="block_api" value="&lt;b&gt;Unattached Block Volume API&lt;/b&gt;&#xa;/cost-unattached-block-volumes&#xa;兼容 /cost-unattached-ebs-volumes&#xa;可关联 attribution owner/context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="lane_serve">
          <mxGeometry x="30" y="850" width="390" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="budget_table" value="&lt;b&gt;cost_budgets&lt;/b&gt;&#xa;当前手工 / 未来 Lark 同步&#xa;&lt;b&gt;粒度&lt;/b&gt;：vendor/account + period + canonical label_filters&#xa;可按 repo/group/manager 过滤" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="lane_serve">
          <mxGeometry x="30" y="1200" width="390" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;颜色&lt;/b&gt;&#xa;灰：外部源　蓝：ETL/分摊　绿：TiDB 台账&#xa;紫：语义计算　橙：消费/汇总　红：退役" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#ffffff;strokeColor=#9ca3af;fontSize=12;" vertex="1" parent="lane_serve">
          <mxGeometry x="30" y="1400" width="390" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="e1" value="分区裁剪后聚合" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6c8ebf;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.25;" edge="1" parent="1" source="gcp_bq" target="billing_aggregate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="分区裁剪后聚合" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6c8ebf;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="aws_bq" target="billing_aggregate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="日级 + 业务维度 upsert" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.35;entryX=0;entryY=0.35;" edge="1" parent="1" source="billing_aggregate" target="summary_table"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="账单事实" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.35;entryX=0;entryY=0.3;" edge="1" parent="1" source="summary_table" target="attribution"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="身份 / 组织映射" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="roster_tables" target="attribution"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="同步" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="roster_source" target="roster_tables"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="去掉 export partition，再按归因维度汇总" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d79b00;strokeWidth=2;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.35;entryX=0;entryY=0.35;" edge="1" parent="1" source="attribution" target="attribution_table"><mxGeometry relative="1" as="geometry"/></mxCell>
