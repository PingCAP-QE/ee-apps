{{/* All dynamic YAML scalars are JSON-quoted to prevent data changing layout. */}}
schema: "2.0"
config:
  width_mode: default
header:
  template: {{ StatusColor .Status }}
  title:
    tag: plain_text
    {{- $hotfix := ternary " 🔥HOTFIX" "" .IsHotfix }}
    content: {{ printf "%s%s DevBuild #%d - %s %s" (StatusEmoji .Status) $hotfix .BuildID .Product .Edition | toJson }}
body:
  elements:
    - tag: div
      fields:
        {{- with .Status }}
        - is_short: false
          text:
            tag: lark_md
            content: {{ printf "**Status:**\t%s%s" (StatusEmoji .) (Escape .) | toJson }}
        {{- end }}
        {{- with .CreatedBy }}
        - is_short: false
          text:
            tag: lark_md
            content: {{ printf "🧑‍💻 **Created By:**\t%s" (Escape .) | toJson }}
        {{- end }}
        {{- with .CreatedAt }}
        - is_short: false
          text:
            tag: lark_md
            content: {{ printf "🛫 **Created at:**\t%s" (Escape .) | toJson }}
        {{- end }}
        {{- with .CompletedAt }}
        - is_short: false
          text:
            tag: lark_md
            content: {{ printf "🛬 **Completed time:**\t%s" (Escape .) | toJson }}
        {{- end }}
    - tag: hr
    {{- $request := printf "**Request:**\n- **Product:** %s\n- **Edition:** %s\n- **Version:** %s" (Escape .Product) (Escape .Edition) (Escape .Version) }}
    {{- if .IsHotfix }}
      {{- $request = printf "%s\n- **Hotfix:** 🔥 Yes" $request }}
    {{- end }}
    {{- $request = printf "%s\n- **Platform:** %s" $request (Escape .Platform) }}
    {{- with .GithubRepo }}
      {{- $request = printf "%s\n- **Repository:** %s" $request (Link . (printf "https://github.com/%s" .)) }}
    {{- end }}
    {{- $request = printf "%s\n- **Git Ref:** %s" $request (Link .GitRef (GitRefURL .GitRef .GithubRepo)) }}
    - tag: markdown
      content: {{ $request | toJson }}

    {{- if or .GitSha .ImageGroups .BinaryGroups }}
    - tag: hr
    {{- $report := "**Build Report**" }}
    {{- with .GitSha }}
      {{- $report = printf "%s\n- **Git SHA:** %s" $report (Link . (GitRefURL (printf "commit/%s" .) $.GithubRepo)) }}
    {{- end }}
    {{- if .ImageGroups }}
      {{- $report = printf "%s\n- **Docker Images:**" $report }}
    {{- end }}
    - tag: markdown
      content: {{ $report | toJson }}
    {{- $showSync := and (not .IsHotfix) (ValidHTTPURL .ImageSyncURL) }}
    {{- range .ImageGroups }}
    - tag: markdown
      content: {{ printf "- %s" (Code .Repo) | toJson }}
      margin: 0px 0px 0px 22px
    - tag: table
      margin: 0px 0px 0px 44px
      page_size: 5
      row_height: auto
      row_max_height: 999px
      header_style:
        text_align: left
        text_size: normal
        background_style: none
        bold: true
      columns:
        - name: platform
          display_name: Platform
          width: auto
          data_type: text
          vertical_align: top
        - name: tag
          display_name: Tag
          width: auto
          data_type: markdown
          vertical_align: top
        {{- if $showSync }}
        - name: action
          display_name: Action
          width: auto
          data_type: markdown
          vertical_align: top
        {{- end }}
      rows:
        {{- range .Platforms }}
        {{- $platform := ternary "Multi-arch" .Platform (eq .Platform "multi-arch") }}
        {{- range .Tags }}
        - platform: {{ $platform | toJson }}
          tag: {{ Code .Tag | toJson }}
          {{- if $showSync }}
            {{- $action := "—" }}
            {{- with ImageSyncURL $.ImageSyncURL .Reference }}
              {{- $action = Link "🧪 Sync" . }}
            {{- end }}
          action: {{ $action | toJson }}
          {{- end }}
        {{- end }}
        {{- end }}
    {{- end }}
    {{- if .BinaryGroups }}
    - tag: markdown
      content: "- **Binaries:**"
    - tag: table
      margin: 0px 0px 0px 22px
      page_size: 5
      row_height: auto
      row_max_height: 999px
      header_style:
        text_align: left
        text_size: normal
        background_style: none
        bold: true
      columns:
        - name: platform
          display_name: Platform
          width: auto
          data_type: text
          vertical_align: top
        - name: file
          display_name: File
          width: auto
          data_type: markdown
          vertical_align: top
        - name: checksum
          display_name: Checksum
          width: auto
          data_type: markdown
          vertical_align: top
      rows:
        {{- range .BinaryGroups }}
        {{- $platform := default "Unknown platform" .Platform }}
        {{- range .Files }}
          {{- $file := Link .FileName .URL }}
          {{- if not .Downloadable }}
            {{- $file = printf "%s · <font color='grey'>Download service is not configured</font>" $file }}
          {{- end }}
          {{- $checksum := "—" }}
          {{- if .HasChecksum }}
            {{- $checksum = Link "sha256" .Sha256URL }}
          {{- end }}
        - platform: {{ $platform | toJson }}
          file: {{ $file | toJson }}
          checksum: {{ $checksum | toJson }}
        {{- end }}
        {{- end }}
    {{- end }}
    {{- end }}
    {{- if .PipelineRuns }}
    - tag: hr
    {{- $pipelines := "**Pipeline Runs:**" }}
    {{- range .PipelineRuns }}
      {{- $pipelines = printf "%s\n- %s **%s:** %s" $pipelines (PipelineStatusEmoji .Status) (Escape .Name) (Link .Status .URL) }}
    {{- end }}
    - tag: markdown
      content: {{ $pipelines | toJson }}
    {{- end }}
    {{- with .ErrMsg }}
    - tag: hr
    - tag: markdown
      content: {{ printf "**Error:**\n%s" (Escape .) | toJson }}
    {{- end }}
