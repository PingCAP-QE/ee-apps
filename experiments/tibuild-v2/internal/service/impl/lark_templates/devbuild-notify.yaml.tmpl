{{/* All dynamic YAML scalars are JSON-quoted to prevent data changing layout. */}}
schema: "2.0"
config:
  width_mode: default
header:
  template: {{ StatusColor .Status }}
  title:
    tag: plain_text
    {{- $hotfix := ternary " 🔥HOTFIX" "" .IsHotfix }}
    content: {{ printf "%s%s DevBuild #%d - %s %s" (StatusEmoji .Status) $hotfix .BuildID .Product .Edition | toJson }}
body:
  elements:
    - tag: div
      fields:
        {{- with .Status }}
        - is_short: false
          text:
            tag: lark_md
            content: {{ printf "**Status:**\t%s%s" (StatusEmoji .) (Escape .) | toJson }}
        {{- end }}
        {{- with .CreatedBy }}
        - is_short: false
          text:
            tag: lark_md
            content: {{ printf "🧑‍💻 **Created By:**\t%s" (Escape .) | toJson }}
        {{- end }}
        {{- with .CreatedAt }}
        - is_short: false
          text:
            tag: lark_md
            content: {{ printf "🛫 **Created at:**\t%s" (Escape .) | toJson }}
        {{- end }}
        {{- with .CompletedAt }}
        - is_short: false
          text:
            tag: lark_md
            content: {{ printf "🛬 **Completed time:**\t%s" (Escape .) | toJson }}
        {{- end }}
    - tag: hr
    {{- $request := printf "**Request:**\n- **Product:** %s\n- **Edition:** %s\n- **Version:** %s" (Escape .Product) (Escape .Edition) (Escape .Version) }}
    {{- if .IsHotfix }}
      {{- $request = printf "%s\n- **Hotfix:** 🔥 Yes" $request }}
    {{- end }}
    {{- $request = printf "%s\n- **Platform:** %s" $request (Escape .Platform) }}
    {{- with .GithubRepo }}
      {{- $request = printf "%s\n- **Repository:** %s" $request (Link . (printf "https://github.com/%s" .)) }}
    {{- end }}
    {{- $request = printf "%s\n- **Git Ref:** %s" $request (Link .GitRef (GitRefURL .GitRef .GithubRepo)) }}
    - tag: markdown
      content: {{ $request | toJson }}

    {{- if or .GitSha .ImageGroups .BinaryGroups }}
    - tag: hr
    {{- $report := "**Build Report**" }}
    {{- with .GitSha }}
      {{- $report = printf "%s\n- **Git SHA:** %s" $report (Link . (GitRefURL (printf "commit/%s" .) $.GithubRepo)) }}
    {{- end }}
    - tag: markdown
      content: {{ $report | toJson }}
    {{- end }}
    {{- if .ImageGroups }}
    - tag: markdown
      content: "**Docker Images:**"
    - tag: column_set
      flex_mode: none
      columns:
        - tag: column
          width: weighted
          weight: 1
          padding: "0px 0px 0px 16px"
          vertical_spacing: 12px
          elements:
            {{- range .ImageGroups }}
            - tag: markdown
              content: {{ printf "**Repository:** %s" (Escape .Repo) | toJson }}
            - tag: column_set
              flex_mode: none
              columns:
                - tag: column
                  width: weighted
                  weight: 1
                  padding: "0px 0px 0px 16px"
                  vertical_spacing: 4px
                  elements:
                    {{- range .Platforms }}
                    {{- $platform := ternary "Multi-arch" .Platform (eq .Platform "multi-arch") }}
                    {{- $tags := list }}
                    {{- range .Tags }}
                      {{- $tags = append $tags (Escape .Tag) }}
                    {{- end }}
                    - tag: markdown
                      content: {{ printf "**%s:** %s" (Escape $platform) (join " · " $tags) | toJson }}
                    {{- end }}
            {{- end }}
    {{- end }}
    {{- if .BinaryGroups }}
    - tag: markdown
      content: "**Binaries:**"
    - tag: column_set
      flex_mode: none
      columns:
        - tag: column
          width: weighted
          weight: 1
          padding: "0px 0px 0px 16px"
          vertical_spacing: 12px
          elements:
            {{- range .BinaryGroups }}
            - tag: markdown
              content: {{ printf "**%s**" (Escape (default "Unknown platform" .Platform)) | toJson }}
            - tag: column_set
              flex_mode: none
              columns:
                - tag: column
                  width: weighted
                  weight: 1
                  padding: "0px 0px 0px 16px"
                  vertical_spacing: 4px
                  elements:
                    {{- range .Files }}
                    {{- $file := Link .FileName .URL }}
                    {{- if .HasChecksum }}
                      {{- $file = printf "%s · %s" $file (Link "SHA256" .Sha256URL) }}
                    {{- end }}
                    {{- if not .Downloadable }}
                      {{- $file = printf "%s\n<font color='grey'>Download service is not configured</font>" $file }}
                    {{- end }}
                    - tag: markdown
                      content: {{ $file | toJson }}
                    {{- end }}
            {{- end }}
    {{- end }}
    {{- if .PipelineRuns }}
    - tag: hr
    {{- $pipelines := "**Pipeline Runs:**" }}
    {{- range .PipelineRuns }}
      {{- $pipelines = printf "%s\n- %s **%s:** %s" $pipelines (PipelineStatusEmoji .Status) (Escape .Name) (Link .Status .URL) }}
    {{- end }}
    - tag: markdown
      content: {{ $pipelines | toJson }}
    {{- end }}
    {{- with .ErrMsg }}
    - tag: hr
    - tag: markdown
      content: {{ printf "**Error:**\n%s" (Escape .) | toJson }}
    {{- end }}
